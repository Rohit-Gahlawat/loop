# Copy to .env and fill in. Never commit .env.

# Neon Postgres. Two connection strings from the same database.
# DATABASE_URL is the pooled one, used at runtime.
# DIRECT_URL is the unpooled one, used only by migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Chat model. Gemini through its OpenAI-compatible endpoint.
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-3.5-flash-lite"
# Get one at https://aistudio.google.com/apikey. Used for embeddings too.
AI_API_KEY=""

# Embeddings. Must match the vector size in the Prisma schema.
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"
